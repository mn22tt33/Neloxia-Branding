# Server Configuration
PORT=4000
NODE_ENV=development
APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# Browser Execution Mode: 'local' (headed Chromium window) or 'production' (headless Railway container)
BROWSER_MODE=local
SPX_BASE_URL=https://egy.app.spx-learning-square.com/

# Security & Authentication
JWT_SECRET=super-secret-jwt-key-change-in-production-min-32-chars-long-12345
JWT_EXPIRES_IN=7d
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef # 32 bytes hex for AES-256

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smart_solver?schema=public

# Redis & BullMQ
REDIS_URL=redis://localhost:6379

# AI Provider Configuration
# Supported: gemini, openai, anthropic, mock
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_api_key_here
AI_MODEL_NAME=gemini-1.5-flash

# Browser & VNC Settings
DISPLAY_BASE=100
VNC_PORT_BASE=5900
NOVNC_PORT_BASE=6080
NOVNC_PUBLIC_BASE_URL=http://localhost
ALLOWED_DOMAINS=example.com,education.gov,khanacademy.org,coursera.org,quizlet.com,wikipedia.org,egy.app.spx-learning-square.com,spx-learning-square.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
